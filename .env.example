# Root .env.example. Copy to .env (or apps/api/.env) and fill in values.
# The .env file itself is gitignored.
#
# Each app reads from its own apps/<app>/.env in addition to this root one.
# Keeping a root template here so contributors only need to copy once.

# ── apps/api ───────────────────────────────────────────────────────────────

# Webhook secret configured in your GitHub App's settings.
# Generate with: openssl rand -hex 32
# Required at boot — apps/api refuses to start without it.
GITHUB_WEBHOOK_SECRET=

# Where the SQLite database file lives. Relative paths resolve from apps/api/.
# The directory must exist (data/ is gitignored; create it before first boot).
DATABASE_PATH=./data/app.sqlite

# Port apps/api listens on. apps/web defaults to 4000 — don't collide.
PORT=4001

# ── RAG foundation ────────────────────────────────────────────────────────

# Voyage AI API key. Required at boot — apps/api refuses to start without it.
# Sign up at https://www.voyageai.com/ and attach a payment method to lift the
# free-tier 3 RPM / 10K TPM cap. See docs/setup/embeddings.md.
VOYAGE_API_KEY=

# Chroma HTTP endpoint. Default targets the local Docker Compose service.
CHROMA_URL=http://localhost:8000

# Chroma collection name (one collection per embedding model).
CHROMA_COLLECTION=code-style-rules

# Voyage embedding model — `voyage-code-3` is code-tuned and the default.
EMBEDDING_MODEL=voyage-code-3

# ── Anthropic ─────────────────────────────────────────────────────────────

# Required. Generate at console.anthropic.com → API Keys. Set a workspace
# spend cap (~$10–25 covers typical local development) in Settings → Limits.
# See docs/setup/claude.md for the full setup.
ANTHROPIC_API_KEY=

# Optional. Defaults unconditionally to claude-haiku-4-5-20251001 — Haiku's
# quality holds on the focused small-diff PRs this bot targets and per-review
# cost is ~$0.02-0.05. Set explicitly (e.g. claude-sonnet-4-6) to override.
ANTHROPIC_MODEL=

# Optional. Boolean gate on POST /reviews/dry-run. Defaults true in dev,
# false elsewhere.
ENABLE_DRY_RUN=
