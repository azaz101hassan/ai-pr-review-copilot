# Root .env.example. Copy to .env (or apps/api/.env) and fill in values.
# The .env file itself is gitignored.
#
# Each app reads from its own apps/<app>/.env in addition to this root one.
# Keeping a root template here so contributors only need to copy once.

# ── apps/api ───────────────────────────────────────────────────────────────

# Webhook secret configured in your GitHub App's settings.
# Generate with: openssl rand -hex 32
# Required at boot — apps/api refuses to start without it.
GITHUB_WEBHOOK_SECRET=

# Where the SQLite database file lives. Relative paths resolve from apps/api/.
# The directory must exist (data/ is gitignored; create it before first boot).
DATABASE_PATH=./data/app.sqlite

# Port apps/api listens on. apps/web defaults to 3000 — don't collide.
PORT=3001
