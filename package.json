{
  "name": "ai-pr-review-copilot",
  "version": "0.1.0",
  "private": true,
  "description": "AI PR Review Copilot — RAG + agentic LLM that reviews GitHub PRs against a team knowledge base",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azaz101hassan/ai-pr-review-copilot.git"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "dev:api": "npm run start:dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "drizzle-orm": "^0.45.2"
  },
  "overrides": {
    "tmp": "^0.2.6",
    "qs": "^6.15.2",
    "picomatch": "^4.0.4",
    "file-type": "^21.3.2",
    "ajv": "^8.18.0",
    "glob": "^10.5.0",
    "webpack": "^5.104.1",
    "esbuild": "^0.25.0",
    "postcss": "^8.5.10"
  }
}
