{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      { "include": "**/*.sql", "outDir": "dist" },
      { "include": "infrastructure/db/migrations/meta/**/*", "outDir": "dist" }
    ],
    "watchAssets": true
  }
}
