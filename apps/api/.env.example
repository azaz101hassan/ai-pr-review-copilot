# apps/api/.env — copy to apps/api/.env and fill in.
#
# Required at boot. apps/api refuses to start without this.
# Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# SQLite database file. Relative paths resolve from apps/api/.
# Parent directory is created on first boot if missing.
DATABASE_PATH=./data/app.sqlite

# HTTP port. Default 3001 to avoid colliding with apps/web on 3000.
PORT=3001

# ── Day 2 — RAG foundation ────────────────────────────────────────────────

# Voyage AI API key. Required at boot — apps/api refuses to start without it.
# Sign up at https://www.voyageai.com/ and attach a payment method to lift the
# free-tier 3 RPM / 10K TPM cap (the sprint corpus is small enough to fit, but
# any meaningful indexing hits the throttle). See docs/setup/embeddings.md.
VOYAGE_API_KEY=

# Chroma HTTP endpoint. Default targets the local Docker Compose service
# (`docker compose up -d chroma`). Override for a remote Chroma deployment.
CHROMA_URL=http://localhost:8000

# Chroma collection name. One collection per embedding model is the convention
# — the collection name carries the model version implicitly.
CHROMA_COLLECTION=code-style-rules

# Voyage embedding model. `voyage-code-3` is code-tuned and the project default.
# Asymmetric encoding: index uses input_type="document", query uses "query".
EMBEDDING_MODEL=voyage-code-3

# ── Day 3 — Anthropic ─────────────────────────────────────────────────────

# Required. Generate at console.anthropic.com → API Keys. Set a workspace
# spend cap in the console too (Settings → Limits, ~$10–25 for the sprint).
# Stored only in your local .env (gitignored). Never commit.
ANTHROPIC_API_KEY=

# Optional. When unset, defaults to claude-haiku-4-5-20251001 in dev (8× cheaper
# per call — great for iteration) and claude-sonnet-4-6 in production (demo
# quality). Set explicitly to force a specific tier:
#   - claude-haiku-4-5-20251001 — cheapest, good enough for iteration
#   - claude-sonnet-4-6         — default for production
#   - claude-opus-4-7           — deepest review, ~5× cost vs Sonnet
ANTHROPIC_MODEL=

# Optional. Boolean gate on `POST /reviews/dry-run` route registration.
# Defaults: true when NODE_ENV=development, false everywhere else.
# Accepts case-insensitive 'true'/'1'/'yes' as truthy.
ENABLE_DRY_RUN=
