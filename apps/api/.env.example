# apps/api/.env — copy to apps/api/.env and fill in.
#
# Required at boot. apps/api refuses to start without this.
# Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# SQLite database file. Relative paths resolve from apps/api/.
# Parent directory is created on first boot if missing.
DATABASE_PATH=./data/app.sqlite

# HTTP port. Default 4001 to avoid colliding with apps/web on 4000.
PORT=4001

# ── Day 2 — RAG foundation ────────────────────────────────────────────────

# Voyage AI API key. Required at boot — apps/api refuses to start without it.
# Sign up at https://www.voyageai.com/ and attach a payment method to lift the
# free-tier 3 RPM / 10K TPM cap (the sprint corpus is small enough to fit, but
# any meaningful indexing hits the throttle). See docs/setup/embeddings.md.
VOYAGE_API_KEY=

# Chroma HTTP endpoint. Default targets the local Docker Compose service
# (`docker compose up -d chroma`). Override for a remote Chroma deployment.
CHROMA_URL=http://localhost:8000

# Chroma collection name. One collection per embedding model is the convention
# — the collection name carries the model version implicitly.
CHROMA_COLLECTION=code-style-rules

# Voyage embedding model. `voyage-code-3` is code-tuned and the project default.
# Asymmetric encoding: index uses input_type="document", query uses "query".
EMBEDDING_MODEL=voyage-code-3

# ── Day 3 — Anthropic ─────────────────────────────────────────────────────

# Required. Generate at console.anthropic.com → API Keys. Set a workspace
# spend cap in the console too (Settings → Limits, ~$10–25 for the sprint).
# Stored only in your local .env (gitignored). Never commit.
ANTHROPIC_API_KEY=

# Optional. When unset, defaults to claude-haiku-4-5-20251001 in dev (8× cheaper
# per call — great for iteration) and claude-sonnet-4-6 in production (demo
# quality). Set explicitly to force a specific tier:
#   - claude-haiku-4-5-20251001 — cheapest, good enough for iteration
#   - claude-sonnet-4-6         — default for production
#   - claude-opus-4-7           — deepest review, ~5× cost vs Sonnet
ANTHROPIC_MODEL=

# Optional. Boolean gate on `POST /reviews/dry-run` route registration.
# Defaults: true when NODE_ENV=development, false everywhere else.
# Accepts case-insensitive 'true'/'1'/'yes' as truthy.
ENABLE_DRY_RUN=

# ── Day 5 — Real-PR integration ──────────────────────────────────────────
# Full setup walkthrough: docs/setup/day5-real-pr.md
# All Day-5 vars below are required for the worker to boot. apps/api
# refuses to start if any of APP_ID / APP_PRIVATE_KEY / REDIS_URL is
# missing or malformed (fail-fast at construction).

# GitHub App ID (numeric, from your App's Settings → "General" page).
APP_ID=

# GitHub App PEM private key. Download from your App's Settings →
# "Private keys" → "Generate a private key", then convert the multi-line
# PEM into a single .env-safe value by replacing every newline with the
# literal two characters "\n" — e.g.:
#   APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END...
# ConfigService normalises \n → real newlines at boot.
APP_PRIVATE_KEY=

# Redis URL backing the BullMQ review queue. Default targets the local
# docker-compose service (`docker compose up -d redis`). REDIS_PASSWORD
# (host env) is required by docker-compose; include it in the URL too:
#   redis://:${REDIS_PASSWORD}@localhost:6379
# Use rediss:// for TLS in any non-localhost deployment.
REDIS_URL=

# Password used by docker-compose for the redis service. The compose
# file fails to start if this is unset. The same secret should appear
# in REDIS_URL above.
REDIS_PASSWORD=

# Comma-separated allowlist + kill switch for which repositories the
# bot reviews. Format: "owner/repo,owner2/repo2". Empty / unset → the
# bot is silent on every PR (kill switch).
DOGFOOD_REPOS=

# Optional. Boolean gate on Anthropic zero-data-retention mode for
# production / dogfood paths. Defaults to false (the operator opts in).
# Accepts case-insensitive 'true'/'1'/'yes' as truthy.
ANTHROPIC_USE_ZERO_RETENTION=

# Optional. Number of BullMQ jobs the in-process worker processes
# concurrently. Default 1 (per-PR serialization is already guaranteed
# by deterministic jobId; bumping enables multi-PR parallelism but
# raises Anthropic burn rate).
WORKER_CONCURRENCY=

# Optional. Bounded shutdown drain in milliseconds. On SIGTERM the
# worker stops accepting new jobs and waits up to this long for active
# jobs to finish; on timeout the in-flight rows flip to
# failed/process_terminated. Default 15000 (15s) — k8s default
# terminationGracePeriodSeconds is 30s, leaving 15s margin for Nest's
# own shutdown (DB close, etc.). If your platform sets a longer grace
# period, raise this to use it. F14 closure.
SHUTDOWN_DRAIN_TIMEOUT_MS=

# Optional. Maximum unified diff size (bytes) the worker will hand to
# the agent loop. Diffs above this cap mark the row failed/diff_too_large
# with no Anthropic call. Default 262144 (256 KB). This is a coarse
# proxy for Claude's context window; raise if your dogfood diffs hit
# the cap regularly (see Day-5 plan Open Questions).
MAX_DIFF_BYTES=

# ── Test-only escape hatches (NEVER set in production) ────────────
# These bypass boot probes so AppModule-bootstrapping specs don't
# need real GitHub / Redis. Production runs MUST leave them unset
# or false. F32 closure.

# When true, the GET /app probe at boot is skipped. ConfigService
# still validates APP_ID / APP_PRIVATE_KEY shape; only the live
# round-trip is bypassed.
SKIP_GITHUB_APP_PROBE=

# When true, the QueueModule binds REVIEW_QUEUE to a no-op
# implementation and skips the Redis PING boot probe. The webhook
# enqueue path becomes a no-op (useful for HTTP-only tests).
SKIP_REDIS_PROBE=
