{
  "name": "@ai-pr-review-copilot/api",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "PR Review Copilot API — GitHub webhook receiver + RAG/agent backend",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch --preserveWatchOutput",
    "start:prod": "node dist/main",
    "test": "jest --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "seed:knowledge": "ts-node -r tsconfig-paths/register src/modules/embeddings/scripts/seed.ts",
    "query:rules": "ts-node -r tsconfig-paths/register src/modules/embeddings/scripts/query.ts",
    "review:dry-run": "ts-node -r tsconfig-paths/register src/modules/reviews/scripts/dry-run.ts",
    "eval:capture": "ts-node -r tsconfig-paths/register src/modules/reviews/eval/capture.ts",
    "eval:score": "ts-node -r tsconfig-paths/register src/modules/reviews/eval/score.ts",
    "eval:backfill-hash": "ts-node -r tsconfig-paths/register src/modules/reviews/eval/backfill-tracked-paths-hash.ts",
    "seed:dev": "ts-node -r tsconfig-paths/register src/modules/dashboard/scripts/seed-dev.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.99.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.24",
    "@nestjs/core": "^11.1.24",
    "@nestjs/platform-express": "^11.1.24",
    "@nestjs/throttler": "6.5.0",
    "@octokit/auth-app": "^8.2.0",
    "better-sqlite3": "^11.5.0",
    "bullmq": "^5.77.6",
    "chromadb": "^3.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.10.1",
    "octokit": "^5.0.5",
    "reflect-metadata": "^0.2.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "rxjs": "^7.8.1",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.24",
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.0",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "^0.31.10",
    "ioredis-mock": "^8.9.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  }
}
