+import type { LineItem, InvoiceLine } from '@/modules/billing/types/invoice.types';
+
+/** Pure helper -- computes a single invoice line from an order item. */
+export function computeLineTotal(item: LineItem): InvoiceLine {
+  const basePrice = item.unitPrice * item.quantity;
+  const discountFraction = item.discountPercent / 100;
+  const discountAmount = basePrice * discountFraction;
+  const afterDiscount = basePrice - discountAmount;
+  const taxAmount = afterDiscount * item.taxRate;
+  const amount = afterDiscount + taxAmount;
+
+  return {
+    sku: item.sku,
+    description: item.description,
+    amount,
+  };
+}
